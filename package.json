{
  "name": "dsh-replay",
  "version": "0.3.3",
  "description": "Session replay, fork-tree, audit & compare visualization for DeepSeek Harness — time machine for your agent sessions",
  "main": "lib/index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.json",
    "test": "vitest run",
    "demo": "node demo/serve.mjs",
    "screenshots": "node scripts/screenshot.mjs",
    "prepare": "node scripts/build.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "agent",
    "session-replay",
    "observability",
    "audit",
    "timeline",
    "visualization"
  ],
  "author": "MingoZhou",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.28.2",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "types": "lib/types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/src/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/src/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./core": {
      "types": "./lib/types/src/core/index.d.ts",
      "default": "./lib/core.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "scripts/build.mjs",
    "src",
    "types.d.ts",
    "tsconfig.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "@deepseek-ai/dsh-session-query": "*",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-query": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MingoZhou/dsh-replay"
  },
  "homepage": "https://mingozhou.github.io/dsh-replay/",
  "bugs": "https://github.com/MingoZhou/dsh-replay/issues"
}
