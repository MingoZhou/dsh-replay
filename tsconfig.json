{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "lib/types",
    "allowImportingTsExtensions": false,
    "types": ["node"]
  },
  "include": ["src/**/*", "demo/**/*.ts", "demo/**/*.tsx", "types.d.ts"]
}
